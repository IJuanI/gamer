# GamER Hub Deployment Environment Variables
# Copy this to .env.local and fill in your values
# Source with: source .env.local

# GCP Configuration
GCP_PROJECT_ID=unity-dummy
GCP_REGION=us-central1

# Container Registry
CONTAINER_IMAGE_URL=gcr.io/unity-dummy/gamer-hub-api:latest
CONTAINER_IMAGE_TAG=latest

# Terraform Backend
STATE_BUCKET=unity-dummy-terraform-state

# API Secrets
TF_VAR_jwt_secret=$(openssl rand -hex 32)

# Discord OAuth
TF_VAR_discord_client_id=1553032775924187256
TF_VAR_discord_client_secret=2ztYlziDO5y2yJcOxvFTrOuDB9SoMzlb

# Google OAuth (Get from GCP Console)
TF_VAR_google_client_id=YOUR_GOOGLE_CLIENT_ID_HERE
TF_VAR_google_client_secret=YOUR_GOOGLE_CLIENT_SECRET_HERE

# Frontend Origins
TF_VAR_web_origin=https://gameer.com.ar,https://paranagamejam.com.ar

# Additional variables
TF_VAR_container_image_url=${CONTAINER_IMAGE_URL}
TF_VAR_gcp_project_id=${GCP_PROJECT_ID}
TF_VAR_gcp_region=${GCP_REGION}
