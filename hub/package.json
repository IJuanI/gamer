{
  "name": "gamer-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "firebase emulators:exec --project=gamer-hub-dev --only=firestore 'pnpm --parallel -r dev'",
    "dev:api": "pnpm --filter @gamer/api dev",
    "dev:web": "pnpm --filter @gamer/web dev",
    "dev:logged": "mkdir -p logs && pnpm dev 2>&1 | tee logs/dev.log",
    "logs": "tail -F logs/api.log logs/web.log logs/dev.log 2>/dev/null",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @gamer/api test:e2e",
    "test:visual": "pnpm --filter @gamer/web test:visual",
    "db:seed": "pnpm --filter @gamer/api seed:firestore",
    "db:seed:local": "firebase emulators:exec --project=gamer-hub-dev --only=firestore 'pnpm db:seed'",
    "emulator:start": "firebase emulators:start --project=gamer-hub-dev --only=firestore",
    "emulator:stop": "firebase emulators:exec --project=gamer-hub-dev --only=firestore 'echo stopped'",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:migrate": "pnpm --filter @gamer/api prisma:migrate",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down"
  },
  "devDependencies": {
    "firebase-tools": "^13.0.0",
    "puppeteer": "^25.11.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@8.15.9"
}
