# ── Database ─────────────────────────────────────────────
# Matches docker-compose.yml (host port 5433 → container 5432)
DATABASE_URL="postgresql://gamer:gamer@localhost:5433/gamer_hub?schema=public"

# ── API ──────────────────────────────────────────────────
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Secret used to sign session JWTs — change in production
JWT_SECRET="dev-only-change-me-please-32chars-min"
JWT_EXPIRES_IN="7d"

# ── OAuth (optional) ─────────────────────────────────────
# Leave blank to disable a provider; the strategy registers only when set.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Where the API redirects after OAuth completes
OAUTH_CALLBACK_BASE="http://localhost:4000"

# ── Platform links (optional) ────────────────────────────
# CS2 verified rank via FACEIT. Data API key comes from the same FACEIT
# developer app as the OAuth client. Leave blank to disable.
FACEIT_CLIENT_ID=""
FACEIT_CLIENT_SECRET=""
FACEIT_API_KEY=""
# League of Legends verified rank + Valorant identity verification via
# Riot Sign-On. Needs an approved RSO client + production key before this
# can run for real users — see docs/team-pairing-plan.md §2. Leave blank to disable.
RIOT_CLIENT_ID=""
RIOT_CLIENT_SECRET=""
RIOT_API_KEY=""
RIOT_LOL_PLATFORM="la2"

# ── Web ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
