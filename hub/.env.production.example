# GamER Hub API - Production Environment Variables
# Copy this to .env.production and fill in the values from your GCP setup

# API Configuration
NODE_ENV=production
API_PORT=4000

# Security - GENERATE A NEW SECRET FOR PRODUCTION
JWT_SECRET=a8afe0b022dde40a5c129bf335f0ef1c27b9c874f19e94e5d48a373897ab4836

# Frontend CORS Configuration - comma-separated domains
WEB_ORIGIN=https://gameer.com.ar,https://paranagamejam.com.ar

# Discord OAuth
DISCORD_CLIENT_ID=1553032775924187256
DISCORD_CLIENT_SECRET=2ztYlziDO5y2yJcOxvFTrOuDB9SoMzlb

# Google OAuth - GET THESE FROM GCP CONSOLE
# Go to: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# Firebase / Firestore Configuration
# Set to your GCP project ID (e.g., unity-dummy)
# Firestore database authentication uses Application Default Credentials (set via Cloud Run service account)
FIREBASE_PROJECT_ID=unity-dummy

# Optional: Gaming Platform Integrations
# FACEIT_CLIENT_ID=
# FACEIT_CLIENT_SECRET=
# FACEIT_API_KEY=
# RIOT_CLIENT_ID=
# RIOT_CLIENT_SECRET=
# RIOT_API_KEY=
