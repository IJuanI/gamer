// GamER Hub — data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  MEMBER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String
  // Null for accounts created purely via OAuth (no local password).
  passwordHash String?
  role         Role      @default(MEMBER)
  avatarUrl    String?
  accounts     Account[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

// Linked OAuth identities (Discord, Google, ...).
model Account {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}
