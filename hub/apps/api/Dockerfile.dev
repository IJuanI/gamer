# Dev image — hot reload via nest --watch over a bind-mounted workspace.
FROM node:24-alpine
RUN corepack enable && corepack prepare pnpm@8.15.9 --activate
WORKDIR /app
# Source is bind-mounted at runtime (see docker-compose). node_modules is a
# named volume so host/container architectures don't collide.
CMD ["sh", "-c", "pnpm install --filter @gamer/api... && pnpm --filter @gamer/api prisma:generate && pnpm --filter @gamer/api dev"]
